# ReelHub configuration
APP_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Storage paths (must be local disk, not NFS)
STORAGE_ROOT=/data
STORAGE_DATA_PATH=/srv/reelhub

# Master encryption key (32 bytes as hex or base64, or path to file)
# Option A: provide key inline (hex-encoded 32 bytes)
# MASTER_KEY=<32-byte-hex>
# Option B: provide path to a file containing the key (recommended)
MASTER_KEY_FILE=/run/secrets/master_key

# Session secret (256-bit random hex)
SESSION_SECRET=<256-bit-random-hex>

# Browser worker (optional Playwright container for fallback verification)
BROWSER_WORKER_URL=http://browser-worker:4000
BROWSER_WORKER_SECRET=<random-hex>

# Gemini AI API Key (can also be entered via UI Settings page)
# GEMINI_API_KEY=<google-gemini-api-key>

# Cloudflare Tunnel (informational — set up cloudflared on the host)
# TUNNEL_URL=https://reelhub.yourdomain.com

# Optional: override DB path (defaults to STORAGE_ROOT/db/reelhub.sqlite)
# DB_PATH=/data/db/reelhub.sqlite

