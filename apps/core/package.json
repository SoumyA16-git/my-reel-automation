{
  "name": "@reelhub/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsx watch src/index.ts",
